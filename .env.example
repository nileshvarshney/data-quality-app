# App
APP_ENV=local
DEBUG=false

# Snowflake — used for BOTH DQ rule execution and platform data storage
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=DQ_PLATFORM_ROLE

# Warehouse for executing DQ checks (large, concurrent)
SNOWFLAKE_WAREHOUSE=DQ_EXECUTION_WH

# Source data — the Snowflake database/schema being quality-checked
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Platform application tables — stored in a separate database/schema
SNOWFLAKE_APP_DATABASE=DQ_PLATFORM_DB
SNOWFLAKE_APP_SCHEMA=DQ_APP

# LLM Provider: ollama | openai | claude | gemini_flash
LLM_PROVIDER=ollama

# Ollama (local, default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude / Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Scheduler
SCHEDULER_TYPE=apscheduler
DEFAULT_TIMEZONE=America/Los_Angeles

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret key for JWT signing:
#   openssl rand -hex 32
SECRET_KEY=REPLACE-WITH-openssl-rand-hex-32

# REQUIRED: Generate a Fernet key for encrypting credentials at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE-WITH-fernet-generate-key

# Authentication enforcement (must be true in staging/production)
AUTH_REQUIRED=true

# Frontend (set in frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
